# ============================================
# Family Tree App - Production Environment Variables
# Copy this file to .env.production and fill in your values
# Usage: cp .env.production.example .env.production
# ============================================

# ---- Database ----
DB_USER=familytree
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=familytree

# ---- Frontend URLs ----
# Leave these as-is when using Nginx reverse proxy (recommended)
# All requests go through Nginx on port 80, so relative paths work
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_MEDIA_URL=

# ---- Google OAuth (Optional) ----
# Get from: https://console.cloud.google.com/apis/credentials
# Add your EC2 public IP to Authorized JavaScript Origins
GOOGLE_CLIENT_ID=

# ---- Email Configuration ----
# Options: console (dev/testing), gmail (free), resend (free 100/day)
EMAIL_PROVIDER=console
FROM_EMAIL=noreply@familytree.local
FROM_NAME=Family Tree App

# For Gmail: (see GMAIL_SETUP.md)
# EMAIL_PROVIDER=gmail
# GMAIL_USER=your.email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

# For Resend: (https://resend.com - 100 emails/day free)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# ---- Server URLs ----
# Set these to your EC2 public IP or domain name
# Example: http://54.123.45.67 or http://myapp.example.com
API_BASE_URL=http://localhost
FRONTEND_URL=http://localhost
